/// ===================== Plate 분주 위치 추적 =====================

class PlateConfig {
  final String name;
  final int rows;
  final int cols;
  const PlateConfig(this.name, this.rows, this.cols);
}

const List<PlateConfig> kPlateConfigs = [
  PlateConfig('6 Well', 2, 3),
  PlateConfig('12 Well', 3, 4),
  PlateConfig('24 Well', 4, 6),
  PlateConfig('48 Well', 6, 8),
  PlateConfig('96 Well', 8, 12),
  PlateConfig('384 Well', 16, 24),
];

class PlateTrackerPage extends StatefulWidget {
  const PlateTrackerPage({super.key});

  @override
  State<PlateTrackerPage> createState() => _PlateTrackerPageState();
}

class _PlateTrackerPageState extends State<PlateTrackerPage> {
  int configIndex = 4; // 기본값 96 Well
  final ValueNotifier<Set<int>> markedNotifier = ValueNotifier<Set<int>>({});
  bool? dragSelecting; // 드래그 시작 시 "선택 모드"인지 "해제 모드"인지
  Size? gridSize;

  PlateConfig get config => kPlateConfigs[configIndex];

  @override
  void initState() {
    super.initState();
    _load();
  }

  @override
  void dispose() {
    markedNotifier.dispose();
    super.dispose();
  }

  Future<void> _load() async {
    final prefs = await SharedPreferences.getInstance();
    final raw = prefs.getString('plate_${config.name}');
    markedNotifier.value = (raw == null || raw.isEmpty)
        ? <int>{}
        : raw.split(',').map(int.parse).toSet();
  }

  Future<void> _save() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('plate_${config.name}', markedNotifier.value.join(','));
  }

  void _handlePointer(Offset localPos) {
    final size = gridSize;
    if (size == null || size.width <= 0 || size.height <= 0) return;
    final cellW = size.width / config.cols;
    final cellH = size.height / config.rows;
    if (localPos.dx < 0 ||
        localPos.dy < 0 ||
        localPos.dx >= size.width ||
        localPos.dy >= size.height) {
      return; // 그리드 영역 밖으로 손가락이 나가면 무시
    }
    final col = (localPos.dx / cellW).floor().clamp(0, config.cols - 1);
    final row = (localPos.dy / cellH).floor().clamp(0, config.rows - 1);
    final idx = row * config.cols + col;

    final current = markedNotifier.value;
    dragSelecting ??= !current.contains(idx);

    final alreadySet = dragSelecting == true ? current.contains(idx) : !current.contains(idx);
    if (alreadySet) return; // 변화가 없으면 불필요한 리빌드 생략

    final next = Set<int>.from(current);
    if (dragSelecting == true) {
      next.add(idx);
    } else {
      next.remove(idx);
    }
    // ValueNotifier만 갱신 → 아래 ValueListenableBuilder로 감싼 부분만 다시 그려짐
    // (드롭다운, 상단 타이틀 등 나머지 화면은 리빌드되지 않음)
    markedNotifier.value = next;
  }

  void _endDrag() {
    dragSelecting = null;
    _save();
  }

  Future<void> _confirmReset() async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: const Color(0xFF1a1a1a),
        title: const Text('전체 초기화', style: TextStyle(color: Colors.white)),
        content: Text(
          '${config.name} 플레이트의 선택을 모두 지울까요?',
          style: const TextStyle(color: Colors.white70),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('취소'),
          ),
          ElevatedButton(
            onPressed: () => Navigator.pop(context, true),
            style: ElevatedButton.styleFrom(backgroundColor: Colors.redAccent),
            child: const Text('초기화'),
          ),
        ],
      ),
    );
    if (ok == true) {
      markedNotifier.value = <int>{};
      _save();
    }
  }

  String _rowLabel(int r) => String.fromCharCode(65 + r); // A, B, C ...

  @override
  Widget build(BuildContext context) {
    const labelSize = 22.0;

    return SafeArea(
      child: Column(
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 4),
            child: Row(
              children: [
                const Text(
                  'Plate 분주 위치',
                  style: TextStyle(
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                    color: Colors.white,
                  ),
                ),
                const Spacer(),
                DropdownButton<int>(
                  value: configIndex,
                  dropdownColor: const Color(0xFF1a1a1a),
                  style: const TextStyle(color: Colors.greenAccent, fontSize: 16),
                  underline: Container(height: 1, color: Colors.grey.shade700),
                  items: [
                    for (int i = 0; i < kPlateConfigs.length; i++)
                      DropdownMenuItem(
                        value: i,
                        child: Text(kPlateConfigs[i].name),
                      ),
                  ],
                  onChanged: (i) {
                    if (i == null) return;
                    setState(() => configIndex = i);
                    _load();
                  },
                ),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            child: Row(
              children: [
                ValueListenableBuilder<Set<int>>(
                  valueListenable: markedNotifier,
                  builder: (context, marked, _) => Text(
                    '${marked.length} / ${config.rows * config.cols} 완료',
                    style: const TextStyle(color: Colors.grey, fontSize: 14),
                  ),
                ),
                const Spacer(),
                TextButton.icon(
                  onPressed: _confirmReset,
                  icon: const Icon(Icons.refresh, color: Colors.redAccent, size: 18),
                  label: const Text('초기화', style: TextStyle(color: Colors.redAccent)),
                ),
              ],
            ),
          ),
          const SizedBox(height: 8),
          Expanded(
            child: Padding(
              padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
              child: Column(
                children: [
                  // 열 번호 헤더
                  Row(
                    children: [
                      const SizedBox(width: labelSize),
                      Expanded(
                        child: Row(
                          children: List.generate(
                            config.cols,
                            (c) => Expanded(
                              child: Center(
                                child: Text(
                                  '${c + 1}',
                                  style: const TextStyle(color: Colors.grey, fontSize: 11),
                                ),
                              ),
                            ),
                          ),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 4),
                  // 행 라벨 + 그리드 본체
                  Expanded(
                    child: Row(
                      children: [
                        SizedBox(
                          width: labelSize,
                          child: Column(
                            children: List.generate(
                              config.rows,
                              (r) => Expanded(
                                child: Center(
                                  child: Text(
                                    _rowLabel(r),
                                    style: const TextStyle(color: Colors.grey, fontSize: 11),
                                  ),
                                ),
                              ),
                            ),
                          ),
                        ),
                        Expanded(
                          child: GestureDetector(
                            behavior: HitTestBehavior.opaque,
                            onPanDown: (d) => _handlePointer(d.localPosition),
                            onPanUpdate: (d) => _handlePointer(d.localPosition),
                            onPanEnd: (_) => _endDrag(),
                            onPanCancel: _endDrag,
                            child: LayoutBuilder(
                              builder: (context, constraints) {
                                gridSize = Size(constraints.maxWidth, constraints.maxHeight);
                                const spacing = 2.0;
                                final cellW =
                                    (constraints.maxWidth - spacing * (config.cols - 1)) / config.cols;
                                final cellH =
                                    (constraints.maxHeight - spacing * (config.rows - 1)) / config.rows;
                                return ValueListenableBuilder<Set<int>>(
                                  valueListenable: markedNotifier,
                                  builder: (context, marked, _) {
                                    return Column(
                                      mainAxisSize: MainAxisSize.min,
                                      children: List.generate(config.rows, (r) {
                                        return Padding(
                                          padding: EdgeInsets.only(
                                            bottom: r == config.rows - 1 ? 0 : spacing,
                                          ),
                                          child: Row(
                                            mainAxisSize: MainAxisSize.min,
                                            children: List.generate(config.cols, (c) {
                                              final index = r * config.cols + c;
                                              final isMarked = marked.contains(index);
                                              return Padding(
                                                padding: EdgeInsets.only(
                                                  right: c == config.cols - 1 ? 0 : spacing,
                                                ),
                                                child: Container(
                                                  width: cellW,
                                                  height: cellH,
                                                  decoration: BoxDecoration(
                                                    color: isMarked
                                                        ? Colors.greenAccent
                                                        : Colors.grey.shade900,
                                                    border: Border.all(
                                                      color: Colors.grey.shade700,
                                                      width: 0.5,
                                                    ),
                                                    borderRadius: BorderRadius.circular(3),
                                                  ),
                                                ),
                                              );
                                            }),
                                          ),
                                        );
                                      }),
                                    );
                                  },
                                );
                              },
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

/// ===================== 시약 제조 계산기 =====================

enum ConcUnit { M, mM, uM, nM }

extension ConcUnitX on ConcUnit {
  String get label {
    switch (this) {
      case ConcUnit.M:
        return 'M';
      case ConcUnit.mM:
        return 'mM';
      case ConcUnit.uM:
        return 'µM';
      case ConcUnit.nM:
        return 'nM';
    }
  }

  // 1 unit = X mol/L
  double get toMolPerL {
    switch (this) {
      case ConcUnit.M:
        return 1;
      case ConcUnit.mM:
        return 1e-3;
      case ConcUnit.uM:
        return 1e-6;
      case ConcUnit.nM:
        return 1e-9;
    }
  }
}

enum VolUnit { L, mL, uL }

extension VolUnitX on VolUnit {
  String get label {
    switch (this) {
      case VolUnit.L:
        return 'L';
      case VolUnit.mL:
        return 'mL';
      case VolUnit.uL:
        return 'µL';
    }
  }

  // 1 unit = X L
  double get toL {
    switch (this) {
      case VolUnit.L:
        return 1;
      case VolUnit.mL:
        return 1e-3;
      case VolUnit.uL:
        return 1e-6;
    }
  }
}

enum MassUnit { g, mg, ug }

extension MassUnitX on MassUnit {
  String get label {
    switch (this) {
      case MassUnit.g:
        return 'g';
      case MassUnit.mg:
        return 'mg';
      case MassUnit.ug:
        return 'µg';
    }
  }

  // 1 g = X of this unit
  double get fromG {
    switch (this) {
      case MassUnit.g:
        return 1;
      case MassUnit.mg:
        return 1e3;
      case MassUnit.ug:
        return 1e6;
    }
  }
}

