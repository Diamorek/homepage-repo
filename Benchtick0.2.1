        const SizedBox(height: 12),
        _NumField(label: '목표 농도 (% w/v)', controller: percentCtrl, onChanged: (_) => setState(() {})),
        const SizedBox(height: 12),
        Row(
          children: [
            Expanded(
              flex: 2,
              child: _NumField(label: '최종 부피', controller: volCtrl, onChanged: (_) => setState(() {})),
            ),
            const SizedBox(width: 8),
            _UnitDropdown<VolUnit>(
              value: volUnit,
              items: VolUnit.values,
              labelOf: (u) => u.label,
              onChanged: (u) => setState(() => volUnit = u),
            ),
          ],
        ),
        const SizedBox(height: 12),
        Align(
          alignment: Alignment.centerRight,
          child: _UnitDropdown<MassUnit>(
            value: massUnit,
            items: MassUnit.values,
            labelOf: (u) => '결과 단위: ${u.label}',
            onChanged: (u) => setState(() => massUnit = u),
          ),
        ),
        if (result != null)
          _resultCard('필요한 질량', '${_fmtNum(result!)} ${massUnit.label}'),
      ],
    );
  }
}

class _UnitDropdown<T> extends StatelessWidget {
  final T value;
  final List<T> items;
  final String Function(T) labelOf;
  final ValueChanged<T> onChanged;
  const _UnitDropdown({
    required this.value,
    required this.items,
    required this.labelOf,
    required this.onChanged,
  });

  @override
  Widget build(BuildContext context) {
    return DropdownButton<T>(
      value: value,
      dropdownColor: const Color(0xFF1a1a1a),
      style: const TextStyle(color: Colors.greenAccent, fontSize: 14),
      underline: Container(height: 1, color: Colors.grey.shade700),
      items: [
        for (final it in items) DropdownMenuItem(value: it, child: Text(labelOf(it))),
      ],
      onChanged: (v) {
        if (v != null) onChanged(v);
      },
    );
  }
}

String _fmtNum(double v) {
  if (v == 0) return '0';
  final absV = v.abs();
  // 아주 작거나 큰 값은 지수 표기, 그 외엔 유효숫자 4자리 정도로 표시
  if (absV < 0.0001 || absV >= 1000000) {
    return v.toStringAsExponential(3);
  }
  String s = v.toStringAsFixed(v.abs() < 1 ? 6 : 4);
  // 뒤에 붙는 불필요한 0 제거
  s = s.replaceAll(RegExp(r'0+$'), '');
  s = s.replaceAll(RegExp(r'\.$'), '');
  return s;
}

/// ===================== 프로토콜 기록 =====================

class ProtocolStep {
  String text;
  bool done;
  DateTime? completedAt;
  ProtocolStep({required this.text, this.done = false, this.completedAt});

  Map<String, dynamic> toJson() => {
        'text': text,
        'done': done,
        'completedAt': completedAt?.toIso8601String(),
      };

  static ProtocolStep fromJson(Map<String, dynamic> j) => ProtocolStep(
        text: j['text'] ?? '',
        done: j['done'] ?? false,
        completedAt:
            j['completedAt'] != null ? DateTime.tryParse(j['completedAt']) : null,
      );
}

class LabProtocol {
  String id;
  String name;
  List<ProtocolStep> steps;
  LabProtocol({required this.id, required this.name, required this.steps});

  Map<String, dynamic> toJson() => {
        'id': id,
        'name': name,
        'steps': steps.map((s) => s.toJson()).toList(),
      };

  static LabProtocol fromJson(Map<String, dynamic> j) => LabProtocol(
        id: j['id'],
        name: j['name'],
        steps: (j['steps'] as List)
            .map((e) => ProtocolStep.fromJson(e as Map<String, dynamic>))
            .toList(),
      );
}

String _fmtDateTime(DateTime? dt) {
  if (dt == null) return '';
  return '${dt.month}/${dt.day} '
      '${dt.hour.toString().padLeft(2, '0')}:'
      '${dt.minute.toString().padLeft(2, '0')}:'
      '${dt.second.toString().padLeft(2, '0')}';
}

Future<void> _shareProtocolViaEmail(BuildContext context, LabProtocol protocol) async {
  final buffer = StringBuffer();
  buffer.writeln('실험 프로토콜: ${protocol.name}');
  buffer.writeln('');
  for (final s in protocol.steps) {
    final status = s.done ? '완료 (${_fmtDateTime(s.completedAt)})' : '미완료';
    buffer.writeln('- ${s.text} : $status');
  }
  final uri = Uri(
    scheme: 'mailto',
    query: 'subject=${Uri.encodeComponent('실험 프로토콜 기록: ${protocol.name}')}'
        '&body=${Uri.encodeComponent(buffer.toString())}',
  );
  final can = await canLaunchUrl(uri);
  if (can) {
    await launchUrl(uri);
  } else if (context.mounted) {
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('메일 앱을 열 수 없어요. 이 기기에 메일 앱이 설정되어 있는지 확인해주세요.'),
      ),
    );
  }
}

class ProtocolListPage extends StatefulWidget {
  const ProtocolListPage({super.key});

  @override
  State<ProtocolListPage> createState() => _ProtocolListPageState();
}

class _ProtocolListPageState extends State<ProtocolListPage> {
  List<LabProtocol> protocols = [];

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final prefs = await SharedPreferences.getInstance();
    final raw = prefs.getString('protocols');
    if (raw != null && raw.isNotEmpty) {
      final list = (jsonDecode(raw) as List)
          .map((e) => LabProtocol.fromJson(e as Map<String, dynamic>))
          .toList();
      setState(() => protocols = list);
    }
  }

  Future<void> _persist() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(
      'protocols',
      jsonEncode(protocols.map((p) => p.toJson()).toList()),
    );
  }

  Future<void> _createNew() async {
    final result = await Navigator.of(context).push<LabProtocol>(
      MaterialPageRoute(builder: (_) => const ProtocolEditorPage()),
    );
    if (result != null) {
      setState(() => protocols.add(result));
      _persist();
    }
  }

  Future<void> _edit(LabProtocol p) async {
    final result = await Navigator.of(context).push<LabProtocol>(
      MaterialPageRoute(builder: (_) => ProtocolEditorPage(existing: p)),
    );
    if (result != null) {
      setState(() {
        final idx = protocols.indexWhere((e) => e.id == p.id);
        if (idx != -1) protocols[idx] = result;
      });
      _persist();
    }
  }

  Future<void> _confirmDelete(LabProtocol p) async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: const Color(0xFF1a1a1a),
        title: const Text('프로토콜 삭제', style: TextStyle(color: Colors.white)),
        content: Text('"${p.name}"을(를) 삭제할까요?', style: const TextStyle(color: Colors.white70)),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('취소')),
          ElevatedButton(
            onPressed: () => Navigator.pop(context, true),
            style: ElevatedButton.styleFrom(backgroundColor: Colors.redAccent),
            child: const Text('삭제'),
          ),
        ],
      ),
    );
    if (ok == true) {
      setState(() => protocols.removeWhere((e) => e.id == p.id));
      _persist();
    }
  }

  Future<void> _run(LabProtocol p) async {
    final updated = await Navigator.of(context).push<LabProtocol>(
      MaterialPageRoute(builder: (_) => ProtocolRunPage(protocol: p)),
    );
    if (updated != null) {
      setState(() {
        final idx = protocols.indexWhere((e) => e.id == p.id);
        if (idx != -1) protocols[idx] = updated;
      });
      _persist();
    }
  }

  @override
  Widget build(BuildContext context) {
    return SafeArea(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 8),
            child: Row(
              children: [
                const Text(
                  '프로토콜',
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold, color: Colors.white),
                ),
                const Spacer(),
                ElevatedButton.icon(
                  onPressed: _createNew,
                  icon: const Icon(Icons.add, size: 18),
                  label: const Text('새로 만들기'),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.greenAccent,
                    foregroundColor: Colors.black,
                  ),
                ),
              ],
            ),
          ),
          Expanded(
            child: protocols.isEmpty
                ? Center(
                    child: Text(
                      '저장된 프로토콜이 없어요.\n"새로 만들기"로 시작해보세요.',
                      textAlign: TextAlign.center,
                      style: TextStyle(color: Colors.grey.shade600),
                    ),
                  )
                : ListView.builder(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    itemCount: protocols.length,
                    itemBuilder: (context, i) {
                      final p = protocols[i];
                      final doneCount = p.steps.where((s) => s.done).length;
                      return Card(
                        color: const Color(0xFF1a1a1a),
                        margin: const EdgeInsets.only(bottom: 10),
                        child: ListTile(
                          title: Text(p.name,
                              style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                          subtitle: Text('$doneCount / ${p.steps.length} 완료',
                              style: const TextStyle(color: Colors.grey)),
                          onTap: () => _run(p),
                          trailing: PopupMenuButton<String>(
                            color: const Color(0xFF1a1a1a),
                            icon: const Icon(Icons.more_vert, color: Colors.grey),
                            onSelected: (v) {
                              if (v == 'edit') _edit(p);
                              if (v == 'delete') _confirmDelete(p);
                              if (v == 'share') _shareProtocolViaEmail(context, p);
                            },
                            itemBuilder: (context) => const [
                              PopupMenuItem(value: 'edit', child: Text('수정')),
                              PopupMenuItem(value: 'share', child: Text('Gmail로 공유')),
                              PopupMenuItem(value: 'delete', child: Text('삭제')),
                            ],
                          ),
                        ),
                      );
                    },
                  ),
          ),
        ],
      ),
    );
  }
}

class ProtocolEditorPage extends StatefulWidget {
  final LabProtocol? existing;
  const ProtocolEditorPage({super.key, this.existing});

  @override
  State<ProtocolEditorPage> createState() => _ProtocolEditorPageState();
}

class _ProtocolEditorPageState extends State<ProtocolEditorPage> {
  late TextEditingController nameCtrl;
  late List<TextEditingController> stepCtrls;

  @override
  void initState() {
    super.initState();
    nameCtrl = TextEditingController(text: widget.existing?.name ?? '');
    if (widget.existing != null) {
      stepCtrls = widget.existing!.steps.map((s) => TextEditingController(text: s.text)).toList();
    } else {
      stepCtrls = List.generate(5, (_) => TextEditingController()); // 기본 5칸 (5~7단계 권장)
    }
  }

  void _addStep() {
    if (stepCtrls.length >= 15) return;
    setState(() => stepCtrls.add(TextEditingController()));
  }

  void _removeStep(int i) {
    if (stepCtrls.length <= 1) return;
    setState(() {
      stepCtrls[i].dispose();
      stepCtrls.removeAt(i);
    });
  }

  void _save() {
    final name = nameCtrl.text.trim();
    if (name.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('프로토콜 이름을 입력해주세요.')),
      );
      return;
    }
    final steps = <ProtocolStep>[];
    for (int i = 0; i < stepCtrls.length; i++) {
      final text = stepCtrls[i].text.trim();
      if (text.isEmpty) continue;
      // 수정 시 기존 완료 상태/시각 유지
      final prev = (widget.existing != null && i < widget.existing!.steps.length)
          ? widget.existing!.steps[i]
          : null;
      steps.add(ProtocolStep(text: text, done: prev?.done ?? false, completedAt: prev?.completedAt));
    }
    if (steps.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('절차를 하나 이상 입력해주세요.')),
      );
      return;
    }
    final protocol = LabProtocol(
      id: widget.existing?.id ?? DateTime.now().millisecondsSinceEpoch.toString(),
      name: name,
      steps: steps,
    );
    Navigator.of(context).pop(protocol);
  }

  @override
  void dispose() {
    nameCtrl.dispose();
    for (final c in stepCtrls) {
      c.dispose();
    }
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      appBar: AppBar(
        backgroundColor: const Color(0xFF111111),
        title: Text(widget.existing == null ? '새 프로토콜' : '프로토콜 수정'),
        actions: [
          TextButton(
            onPressed: _save,
            child: const Text('저장', style: TextStyle(color: Colors.greenAccent)),
          ),
        ],
      ),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: [
            TextField(
              controller: nameCtrl,
              style: const TextStyle(color: Colors.white, fontSize: 18),
              decoration: InputDecoration(
                labelText: '프로토콜 이름',
                labelStyle: const TextStyle(color: Colors.grey),
                enabledBorder: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(10),
                  borderSide: BorderSide(color: Colors.grey.shade700),
                ),
                focusedBorder: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(10),
                  borderSide: const BorderSide(color: Colors.greenAccent),
                ),
              ),
            ),
            const SizedBox(height: 16),
            const Text('절차 (보통 5~7단계 정도가 적당해요)',
                style: TextStyle(color: Colors.grey, fontSize: 13)),
            const SizedBox(height: 8),
            for (int i = 0; i < stepCtrls.length; i++)
              Padding(
                padding: const EdgeInsets.only(bottom: 10),
                child: Row(
                  children: [
                    SizedBox(width: 28, child: Text('${i + 1}.', style: const TextStyle(color: Colors.grey))),
                    Expanded(
                      child: TextField(
                        controller: stepCtrls[i],
                        style: const TextStyle(color: Colors.white),
                        decoration: InputDecoration(
                          hintText: '${i + 1}번째 절차 입력',
                          hintStyle: TextStyle(color: Colors.grey.shade700),
                          enabledBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(8),
                            borderSide: BorderSide(color: Colors.grey.shade800),
                          ),
                          focusedBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(8),
                            borderSide: const BorderSide(color: Colors.greenAccent),
                          ),
                          isDense: true,
                        ),
                      ),
                    ),
                    IconButton(
                      onPressed: stepCtrls.length > 1 ? () => _removeStep(i) : null,
                      icon: const Icon(Icons.remove_circle_outline, color: Colors.redAccent),
                    ),
                  ],
                ),
              ),
            TextButton.icon(
              onPressed: _addStep,
              icon: const Icon(Icons.add, color: Colors.greenAccent),
              label: const Text('절차 추가', style: TextStyle(color: Colors.greenAccent)),
            ),
          ],
        ),
      ),
    );
  }
}

class ProtocolRunPage extends StatefulWidget {
  final LabProtocol protocol;
  const ProtocolRunPage({super.key, required this.protocol});

  @override
  State<ProtocolRunPage> createState() => _ProtocolRunPageState();
}

class _ProtocolRunPageState extends State<ProtocolRunPage> {
  late LabProtocol protocol;

  @override
  void initState() {
    super.initState();
    // 원본을 직접 건드리지 않도록 깊은 복사
    protocol = LabProtocol(
      id: widget.protocol.id,
      name: widget.protocol.name,
      steps: widget.protocol.steps
          .map((s) => ProtocolStep(text: s.text, done: s.done, completedAt: s.completedAt))
          .toList(),
    );
  }

  void _toggle(int i) {
    setState(() {
      final s = protocol.steps[i];
      if (s.done) {
        s.done = false;
        s.completedAt = null;
      } else {
        s.done = true;
        s.completedAt = DateTime.now();
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final doneCount = protocol.steps.where((s) => s.done).length;
    return PopScope(
      canPop: false,
      onPopInvokedWithResult: (bool didPop, dynamic result) {
        if (didPop) return;
        Navigator.of(context).pop(protocol);
      },
      child: Scaffold(
        backgroundColor: Colors.black,
        appBar: AppBar(
          backgroundColor: const Color(0xFF111111),
          title: Text(protocol.name),
          leading: IconButton(
            icon: const Icon(Icons.arrow_back),
            onPressed: () => Navigator.of(context).pop(protocol),
          ),
          actions: [
            IconButton(
              onPressed: () => _shareProtocolViaEmail(context, protocol),
              icon: const Icon(Icons.share),
              tooltip: 'Gmail로 공유',
            ),
          ],
        ),
        body: SafeArea(
          child: Column(
            children: [
              Padding(
                padding: const EdgeInsets.all(16),
                child: Text('$doneCount / ${protocol.steps.length} 완료',
                    style: const TextStyle(color: Colors.grey, fontSize: 14)),
              ),
              Expanded(
                child: ListView.builder(
                  padding: const EdgeInsets.symmetric(horizontal: 16),
                  itemCount: protocol.steps.length,
                  itemBuilder: (context, i) {
                    final s = protocol.steps[i];
                    return Card(
                      color: s.done ? Colors.greenAccent.withValues(alpha: 0.12) : const Color(0xFF1a1a1a),
                      margin: const EdgeInsets.only(bottom: 10),
                      child: ListTile(
                        onTap: () => _toggle(i),
                        leading: Icon(
                          s.done ? Icons.check_circle : Icons.radio_button_unchecked,
                          color: s.done ? Colors.greenAccent : Colors.grey,
                          size: 32,
                        ),
                        title: Text(
                          s.text,
                          style: TextStyle(
                            color: Colors.white,
                            fontSize: 16,
                            decoration: s.done ? TextDecoration.lineThrough : null,
                          ),
                        ),
                        subtitle: s.done
                            ? Text(_fmtDateTime(s.completedAt), style: const TextStyle(color: Colors.greenAccent))
                            : null,
                      ),
                    );
                  },
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

/// ===================== 셀 카운트 =====================

class CellCountPage extends StatefulWidget {
  const CellCountPage({super.key});

  @override
  State<CellCountPage> createState() => _CellCountPageState();
}

class _CellCountPageState extends State<CellCountPage> {
  int count = 0;
  bool showCalc = false;
  int lockedCount = 0;

  final squaresCtrl = TextEditingController(text: '4');
  final dilutionCtrl = TextEditingController(text: '2');
  final targetConcCtrl = TextEditingController();
  final targetVolCtrl = TextEditingController();
  VolUnit targetVolUnit = VolUnit.mL;

  // 펀치백(사진) 관련 상태
  File? punchImage;
  double _circleScale = 1.0;
  int _punchTick = 0;
  String _impactText = '';
  final _rand = Random();
  static const _impactWords = ['퍽!', '팍!', '텅!', '뿅!', '카캉!', '헙!'];

  @override
  void initState() {
    super.initState();
    _loadPunchImage();
  }

  Future<void> _loadPunchImage() async {
    final prefs = await SharedPreferences.getInstance();
    final path = prefs.getString('punch_image_path');
    if (path != null && File(path).existsSync()) {
      setState(() => punchImage = File(path));
    }
  }

  Future<void> _pickImage() async {
    final picked = await ImagePicker().pickImage(source: ImageSource.gallery, imageQuality: 85);
    if (picked == null) return;
    final dir = await getApplicationDocumentsDirectory();
    final savedPath = '${dir.path}/punch_target.jpg';
    final newFile = await File(picked.path).copy(savedPath);
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('punch_image_path', savedPath);
    if (mounted) setState(() => punchImage = newFile);
  }

  Future<void> _removeImage() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove('punch_image_path');
    final img = punchImage;
    if (img != null && img.existsSync()) {
      try {
        img.deleteSync();
      } catch (_) {
        // 삭제 실패해도 무시 (다음에 새 사진으로 덮어쓰면 됨)
      }
    }
    if (mounted) setState(() => punchImage = null);
  }

  void _showPhotoMenu() {
    showModalBottomSheet(
      context: context,
      backgroundColor: const Color(0xFF1a1a1a),
      builder: (context) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            ListTile(
              leading: const Icon(Icons.add_a_photo, color: Colors.greenAccent),
              title: Text(punchImage == null ? '사진 등록' : '사진 변경', style: const TextStyle(color: Colors.white)),
              onTap: () {
                Navigator.pop(context);
                _pickImage();
              },
            ),
            if (punchImage != null)
              ListTile(
                leading: const Icon(Icons.delete_outline, color: Colors.redAccent),
                title: const Text('사진 제거', style: TextStyle(color: Colors.redAccent)),
                onTap: () {
                  Navigator.pop(context);
                  _removeImage();
                },
              ),
          ],
        ),
      ),
    );
  }

  void _increment() {
    HapticFeedback.mediumImpact();
    setState(() {
      count++;
      _punchTick++;
      _impactText = _impactWords[_rand.nextInt(_impactWords.length)];
      _circleScale = 0.88;
    });
    Future.delayed(const Duration(milliseconds: 90), () {
      if (mounted) setState(() => _circleScale = 1.0);
    });
  }

  void _reset() => setState(() => count = 0);

  void _goToCalc() {
    setState(() {
      lockedCount = count;
      showCalc = true;
    });
  }

  void _backToCount() => setState(() => showCalc = false);

  // 혈구계산판 표준 공식: (카운트된 세포 수 / 계산한 칸 수) × 희석배수 × 10^4 = cells/mL
  double? get concentration {
    final squares = double.tryParse(squaresCtrl.text);
    final dilution = double.tryParse(dilutionCtrl.text);
    if (squares == null || squares == 0 || dilution == null) return null;
    return (lockedCount / squares) * dilution * 1e4;
  }

  double? get v1 {
    final c1 = concentration;
    final c2 = double.tryParse(targetConcCtrl.text);
    final v2 = double.tryParse(targetVolCtrl.text);
    if (c1 == null || c1 == 0 || c2 == null || v2 == null) return null;
    return c2 * v2 / c1;
  }

  double? get diluent {
    final v2 = double.tryParse(targetVolCtrl.text);
    final vv1 = v1;
    if (v2 == null || vv1 == null) return null;
    return v2 - vv1;
  }

  @override
  void dispose() {
    squaresCtrl.dispose();
    dilutionCtrl.dispose();
    targetConcCtrl.dispose();
    targetVolCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return SafeArea(child: showCalc ? _buildCalc() : _buildCounter());
  }

  Widget _buildCounter() {
    return Column(
      children: [
        Padding(
          padding: const EdgeInsets.fromLTRB(16, 12, 16, 4),
          child: Row(
            children: [
              const Text('셀 카운트',
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold, color: Colors.white)),
              const Spacer(),
              IconButton(
                onPressed: _showPhotoMenu,
                icon: Icon(
                  punchImage == null ? Icons.add_a_photo_outlined : Icons.photo,
                  color: Colors.greenAccent,
                ),
                tooltip: '펀치백 사진 설정',
              ),
              TextButton.icon(
                onPressed: _reset,
                icon: const Icon(Icons.refresh, color: Colors.redAccent),
                label: const Text('초기화', style: TextStyle(color: Colors.redAccent)),
              ),
            ],
          ),
        ),
        const Spacer(),
        FittedBox(
          child: Text(
            '$count',
            style: const TextStyle(
              fontSize: 88,
              fontWeight: FontWeight.bold,
              color: Colors.greenAccent,
              fontFeatures: [FontFeature.tabularFigures()],
            ),
          ),
        ),
        Text('탭한 횟수 = 카운트된 세포 수', style: TextStyle(color: Colors.grey.shade500)),
        const SizedBox(height: 24),
        Center(
          child: GestureDetector(
            onTap: _increment,
            child: Stack(
              alignment: Alignment.center,
              clipBehavior: Clip.none,
              children: [
                AnimatedScale(
                  scale: _circleScale,
                  duration: const Duration(milliseconds: 120),
                  curve: Curves.easeOut,
                  child: Container(
                    width: 220,
                    height: 220,
                    alignment: Alignment.center,
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: Colors.greenAccent,
                      image: punchImage != null
                          ? DecorationImage(image: FileImage(punchImage!), fit: BoxFit.cover)
                          : null,
                      boxShadow: [
                        BoxShadow(
                          color: Colors.greenAccent.withValues(alpha: 0.35),
                          blurRadius: 30,
                          spreadRadius: 2,
                        ),
                      ],
                    ),
                    child: punchImage == null
                        ? const Text(
                            '탭하여\n카운트 +1',
                            textAlign: TextAlign.center,
                            style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: Colors.black),
                          )
                        : null,
                  ),
                ),
                if (_impactText.isNotEmpty)
                  Positioned(
                    top: -10,
                    child: TweenAnimationBuilder<double>(
                      key: ValueKey(_punchTick),
                      tween: Tween(begin: 0.0, end: 1.0),
                      duration: const Duration(milliseconds: 550),
                      builder: (context, t, child) {
                        return Opacity(
                          opacity: (1 - t).clamp(0.0, 1.0),
                          child: Transform.translate(
                            offset: Offset(0, -40 * t),
                            child: Transform.scale(
                              scale: 1 + 0.4 * (1 - t),
                              child: Text(
                                _impactText,
                                style: const TextStyle(
                                  fontSize: 40,
                                  fontWeight: FontWeight.w900,
                                  color: Colors.orangeAccent,
                                  shadows: [Shadow(blurRadius: 8, color: Colors.black87)],
                                ),
                              ),
                            ),
                          ),
                        );
                      },
                    ),
                  ),
              ],
            ),
          ),
        ),
        const Spacer(),
        Padding(
          padding: const EdgeInsets.fromLTRB(24, 0, 24, 24),
          child: SizedBox(
            width: double.infinity,
            height: 60,
            child: OutlinedButton(
              onPressed: count > 0 ? _goToCalc : null,
              style: OutlinedButton.styleFrom(
                side: const BorderSide(color: Colors.greenAccent, width: 2),
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
              ),
              child: const Text('계산하기 →', style: TextStyle(fontSize: 20, color: Colors.greenAccent)),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildCalc() {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              IconButton(
                onPressed: _backToCount,
                icon: const Icon(Icons.arrow_back, color: Colors.white),
              ),
              const Text('세포 농도 계산',
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold, color: Colors.white)),
            ],
          ),
          _resultCard('카운트된 세포 수', '$lockedCount 개', color: Colors.white),
          const SizedBox(height: 20),
          const Text('현재 농도 계산', style: TextStyle(color: Colors.grey, fontSize: 13)),
          const SizedBox(height: 8),
          Row(
            children: [
              Expanded(
                child: _NumField(
                  label: '계산한 칸 수',
                  controller: squaresCtrl,
                  onChanged: (_) => setState(() {}),
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: _NumField(
                  label: '희석 배수',
                  controller: dilutionCtrl,
                  onChanged: (_) => setState(() {}),
                ),
              ),
            ],
          ),
          if (concentration != null)
            _resultCard('현재 세포 농도', '${_fmtNum(concentration!)} cells/mL'),
          const SizedBox(height: 24),
          const Text('목표 농도로 희석하기', style: TextStyle(color: Colors.grey, fontSize: 13)),
          const SizedBox(height: 8),
          _NumField(
            label: '목표 농도 (cells/mL)',
            controller: targetConcCtrl,
            onChanged: (_) => setState(() {}),
          ),
          const SizedBox(height: 12),
          Row(
            children: [
              Expanded(
                flex: 2,
                child: _NumField(
                  label: '목표 최종 부피',
                  controller: targetVolCtrl,
                  onChanged: (_) => setState(() {}),
                ),
              ),
              const SizedBox(width: 8),
              _UnitDropdown<VolUnit>(
                value: targetVolUnit,
                items: VolUnit.values,
                labelOf: (u) => u.label,
                onChanged: (u) => setState(() => targetVolUnit = u),
              ),
            ],
          ),
          if (v1 != null && diluent != null) ...[
            _resultCard('필요한 세포 현탁액 부피', '${_fmtNum(v1!)} ${targetVolUnit.label}'),
            _resultCard('추가할 배지(희석액)', '${_fmtNum(diluent!)} ${targetVolUnit.label}',
                color: Colors.lightBlueAccent),
          ],
        ],
      ),
    );
  }
}
