/// ===================== 시약 제조 계산기 =====================

enum ConcUnit { M, mM, uM, nM }

extension ConcUnitX on ConcUnit {
  String get label {
    switch (this) {
      case ConcUnit.M:
        return 'M';
      case ConcUnit.mM:
        return 'mM';
      case ConcUnit.uM:
        return 'µM';
      case ConcUnit.nM:
        return 'nM';
    }
  }

  // 1 unit = X mol/L
  double get toMolPerL {
    switch (this) {
      case ConcUnit.M:
        return 1;
      case ConcUnit.mM:
        return 1e-3;
      case ConcUnit.uM:
        return 1e-6;
      case ConcUnit.nM:
        return 1e-9;
    }
  }
}

enum VolUnit { L, mL, uL }

extension VolUnitX on VolUnit {
  String get label {
    switch (this) {
      case VolUnit.L:
        return 'L';
      case VolUnit.mL:
        return 'mL';
      case VolUnit.uL:
        return 'µL';
    }
  }

  // 1 unit = X L
  double get toL {
    switch (this) {
      case VolUnit.L:
        return 1;
      case VolUnit.mL:
        return 1e-3;
      case VolUnit.uL:
        return 1e-6;
    }
  }
}

enum MassUnit { g, mg, ug }

extension MassUnitX on MassUnit {
  String get label {
    switch (this) {
      case MassUnit.g:
        return 'g';
      case MassUnit.mg:
        return 'mg';
      case MassUnit.ug:
        return 'µg';
    }
  }

  // 1 g = X of this unit
  double get fromG {
    switch (this) {
      case MassUnit.g:
        return 1;
      case MassUnit.mg:
        return 1e3;
      case MassUnit.ug:
        return 1e6;
    }
  }
}

