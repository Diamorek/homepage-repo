/// 채널 하나(T1~T4)의 상태
class ChannelState {
  bool running = false;
  bool isCountdown = false; // false = 스탑워치(카운트업), true = 타이머(카운트다운)
  int elapsedMs = 0; // 스탑워치 모드에서 흐른 시간
  int setDurationMs = 0; // 타이머 모드에서 설정한 시간(원본)
  int remainingMs = 0; // 타이머 모드에서 남은 시간
  DateTime? lastTick; // 마지막으로 시간을 갱신한 시각
  bool finished = false; // 타이머가 0에 도달했는지

  int get displayMs => isCountdown ? remainingMs : elapsedMs;

  void reset() {
    running = false;
    elapsedMs = 0;
    remainingMs = setDurationMs;
    finished = false;
    lastTick = null;
  }

  Map<String, dynamic> toJson() => {
        'running': running,
        'isCountdown': isCountdown,
        'elapsedMs': elapsedMs,
        'setDurationMs': setDurationMs,
        'remainingMs': remainingMs,
      };

  static ChannelState fromJson(Map<String, dynamic> json) {
    final c = ChannelState();
    c.running = false; // 앱을 다시 켰을 때는 항상 정지 상태로 불러옴 (안전)
    c.isCountdown = json['isCountdown'] ?? false;
    c.elapsedMs = json['elapsedMs'] ?? 0;
    c.setDurationMs = json['setDurationMs'] ?? 0;
    c.remainingMs = json['remainingMs'] ?? c.setDurationMs;
    return c;
  }
}

class TimerHomePage extends StatefulWidget {
  const TimerHomePage({super.key});

  @override
  State<TimerHomePage> createState() => _TimerHomePageState();
}

class _TimerHomePageState extends State<TimerHomePage> {
  final List<ChannelState> channels =
      List.generate(4, (_) => ChannelState());
  int selected = 0;
  late Timer ticker;
  DateTime now = DateTime.now();

  @override
  void initState() {
    super.initState();
    _loadSaved();
    // 0.1초마다 전체 채널 갱신 (실행 중인 채널만 시간이 흐름)
    ticker = Timer.periodic(const Duration(milliseconds: 100), (_) {
      final t = DateTime.now();
      setState(() {
        now = t;
        for (final c in channels) {
          if (c.running && c.lastTick != null) {
            final delta = t.difference(c.lastTick!).inMilliseconds;
            c.lastTick = t;
            if (c.isCountdown) {
              c.remainingMs -= delta;
              if (c.remainingMs <= 0) {
                c.remainingMs = 0;
                c.running = false;
                if (!c.finished) {
                  c.finished = true;
                  _onTimerFinished();
                }
              }
            } else {
              c.elapsedMs += delta;
            }
          } else if (c.running) {
            c.lastTick = t;
          }
        }
      });
    });
  }

  Future<void> _loadSaved() async {
    final prefs = await SharedPreferences.getInstance();
    for (int i = 0; i < 4; i++) {
      final raw = prefs.getString('channel_$i');
      if (raw != null) {
        // 아주 단순한 저장 포맷: key=value;key=value
        final map = <String, dynamic>{};
        for (final pair in raw.split(';')) {
          if (pair.isEmpty) continue;
          final kv = pair.split('=');
          if (kv.length != 2) continue;
          final key = kv[0];
          final val = kv[1];
          if (key == 'isCountdown') {
            map[key] = val == 'true';
          } else {
            map[key] = int.tryParse(val) ?? 0;
          }
        }
        setState(() {
          channels[i] = ChannelState.fromJson(map);
        });
      }
    }
  }

  Future<void> _saveChannel(int index) async {
    final prefs = await SharedPreferences.getInstance();
    final c = channels[index];
    final str = 'isCountdown=${c.isCountdown};elapsedMs=${c.elapsedMs};'
        'setDurationMs=${c.setDurationMs};remainingMs=${c.remainingMs}';
    await prefs.setString('channel_$index', str);
  }

  void _onTimerFinished() {
    // 타이머 종료 시 알림음 + 진동성 피드백(플랫폼 기본 사운드)
    SystemSound.play(SystemSoundType.alert);
    HapticFeedback.vibrate();
  }

  @override
  void dispose() {
    ticker.cancel();
    super.dispose();
  }

  ChannelState get current => channels[selected];

  void _toggleStartStop() {
    setState(() {
      if (!current.running && current.isCountdown && current.remainingMs <= 0) {
        // 다 끝난 타이머를 다시 시작하면 처음 설정값으로 리셋 후 시작
        current.remainingMs = current.setDurationMs;
        current.finished = false;
      }
      current.running = !current.running;
      current.lastTick = current.running ? DateTime.now() : null;
    });
    _saveChannel(selected);
  }

  void _reset() {
    setState(() {
      current.reset();
    });
    _saveChannel(selected);
  }

  Future<void> _openSetTimeDialog() async {
    final wasRunning = current.running;
    if (wasRunning) {
      setState(() => current.running = false);
    }
    final result = await showDialog<Duration>(
      context: context,
      builder: (context) => const _SetTimeDialog(),
    );
    if (result != null) {
      setState(() {
        // 모드 전환 시 이전 값이 남아있지 않도록 완전히 초기화
        current.isCountdown = result.inMilliseconds > 0;
        current.setDurationMs = result.inMilliseconds;
        current.remainingMs = result.inMilliseconds;
        current.elapsedMs = 0;
        current.finished = false;
        current.running = false;
        current.lastTick = null;
      });
      _saveChannel(selected);
    } else if (wasRunning) {
      setState(() {
        current.running = true;
        current.lastTick = DateTime.now();
      });
    }
  }

  String _fmt(int ms, {bool withMillis = true}) {
    if (ms < 0) ms = 0;
    final h = ms ~/ 3600000;
    final m = (ms % 3600000) ~/ 60000;
    final s = (ms % 60000) ~/ 1000;
    final cs = (ms % 1000) ~/ 10; // centisecond (00~99)
    final hh = h.toString().padLeft(2, '0');
    final mm = m.toString().padLeft(2, '0');
    final ss = s.toString().padLeft(2, '0');
    final ccss = cs.toString().padLeft(2, '0');
    if (h > 0) {
      return withMillis ? '$hh:$mm:$ss.$ccss' : '$hh:$mm:$ss';
    }
    return withMillis ? '$mm:$ss.$ccss' : '$mm:$ss';
  }

  String _fmtClock(DateTime t) {
    return '${t.hour.toString().padLeft(2, '0')}:'
        '${t.minute.toString().padLeft(2, '0')}:'
        '${t.second.toString().padLeft(2, '0')}';
  }

  @override
  Widget build(BuildContext context) {
    final c = current;
    final isRunning = c.running;
    final isFinished = c.isCountdown && c.remainingMs <= 0 && !isRunning;

    return Scaffold(
      body: SafeArea(
        child: Column(
          children: [
            // 상단: 현재 시각
            Padding(
              padding: const EdgeInsets.only(top: 12, bottom: 4),
              child: Text(
                _fmtClock(now),
                style: const TextStyle(
                  fontSize: 28,
                  color: Colors.grey,
                  fontFeatures: [FontFeature.tabularFigures()],
                  fontWeight: FontWeight.w300,
                ),
              ),
            ),
            const SizedBox(height: 8),
            // 채널 선택 탭 (T1~T4)
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 12),
              child: Row(
                children: List.generate(4, (i) {
                  final ch = channels[i];
                  final isSel = i == selected;
                  final chRunning = ch.running;
                  return Expanded(
                    child: GestureDetector(
                      onTap: () => setState(() => selected = i),
                      child: Container(
                        margin: const EdgeInsets.symmetric(horizontal: 4),
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        decoration: BoxDecoration(
                          color: isSel
                              ? Colors.greenAccent.withOpacity(0.15)
                              : Colors.grey.withOpacity(0.08),
                          border: Border.all(
                            color: isSel
                                ? Colors.greenAccent
                                : Colors.grey.shade800,
                            width: isSel ? 2 : 1,
                          ),
                          borderRadius: BorderRadius.circular(10),
                        ),
                        child: Column(
                          children: [
                            Text(
                              'T${i + 1}',
                              style: TextStyle(
                                fontSize: 20,
                                fontWeight: FontWeight.bold,
                                color: isSel ? Colors.greenAccent : Colors.white70,
                              ),
                            ),
                            const SizedBox(height: 2),
                            Row(
                              mainAxisAlignment: MainAxisAlignment.center,
                              children: [
                                if (chRunning)
                                  Container(
                                    width: 8,
                                    height: 8,
                                    margin: const EdgeInsets.only(right: 4),
                                    decoration: const BoxDecoration(
                                      color: Colors.redAccent,
                                      shape: BoxShape.circle,
                                    ),
                                  ),
                                Text(
                                  _fmt(ch.displayMs, withMillis: false),
                                  style: const TextStyle(
                                    fontSize: 14,
                                    color: Colors.white54,
                                    fontFeatures: [FontFeature.tabularFigures()],
                                  ),
                                ),
                              ],
                            ),
                          ],
                        ),
                      ),
                    ),
                  );
                }),
              ),
            ),
            const Spacer(),
            // 메인 디스플레이 (크게)
            Column(
              children: [
                Text(
                  c.isCountdown ? '타이머 (T${selected + 1})' : '스탑워치 (T${selected + 1})',
                  style: TextStyle(
                    fontSize: 20,
                    color: isFinished ? Colors.redAccent : Colors.grey,
                    letterSpacing: 1.5,
                  ),
                ),
                const SizedBox(height: 8),
                GestureDetector(
                  onTap: _openSetTimeDialog,
                  child: FittedBox(
                    child: Text(
                      _fmt(c.displayMs),
                      style: TextStyle(
                        fontSize: 96,
                        fontWeight: FontWeight.bold,
                        fontFeatures: const [FontFeature.tabularFigures()],
                        color: isFinished
                            ? Colors.redAccent
                            : (isRunning ? Colors.greenAccent : Colors.white),
                      ),
                    ),
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  '숫자를 탭하면 시간 설정',
                  style: TextStyle(fontSize: 13, color: Colors.grey.shade600),
                ),
              ],
            ),
            const Spacer(),
            // 컨트롤 버튼
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 24),
              child: Row(
                children: [
                  Expanded(
                    child: SizedBox(
                      height: 72,
                      child: OutlinedButton(
                        onPressed: _reset,
                        style: OutlinedButton.styleFrom(
                          side: const BorderSide(color: Colors.grey, width: 2),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(16),
                          ),
                        ),
                        child: const Text('리셋',
                            style: TextStyle(fontSize: 22, color: Colors.white70)),
                      ),
                    ),
                  ),
                  const SizedBox(width: 16),
                  Expanded(
                    flex: 2,
                    child: SizedBox(
                      height: 72,
                      child: ElevatedButton(
                        onPressed: _toggleStartStop,
                        style: ElevatedButton.styleFrom(
                          backgroundColor:
                              isRunning ? Colors.redAccent : Colors.greenAccent,
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(16),
                          ),
                        ),
                        child: Text(
                          isRunning ? '정지' : (c.elapsedMs > 0 || c.remainingMs != c.setDurationMs ? '재개' : '시작'),
                          style: const TextStyle(
                            fontSize: 24,
                            fontWeight: FontWeight.bold,
                            color: Colors.black,
                          ),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

