/// 1) 몰농도 -> 질량 : mass_g = C(mol/L) * V(L) * MW(g/mol)
class _MolarityToMassForm extends StatefulWidget {
  const _MolarityToMassForm();

  @override
  State<_MolarityToMassForm> createState() => _MolarityToMassFormState();
}

class _MolarityToMassFormState extends State<_MolarityToMassForm> {
  final concCtrl = TextEditingController();
  final volCtrl = TextEditingController();
  final mwCtrl = TextEditingController();
  ConcUnit concUnit = ConcUnit.mM;
  VolUnit volUnit = VolUnit.mL;
  MassUnit massUnit = MassUnit.mg;

  double? get result {
    final c = double.tryParse(concCtrl.text);
    final v = double.tryParse(volCtrl.text);
    final mw = double.tryParse(mwCtrl.text);
    if (c == null || v == null || mw == null) return null;
    final massG = c * concUnit.toMolPerL * v * volUnit.toL * mw;
    return massG * massUnit.fromG;
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          '목표 몰농도 × 부피 × 분자량 = 필요한 질량',
          style: TextStyle(color: Colors.grey, fontSize: 13),
        ),
        const SizedBox(height: 12),
        Row(
          children: [
            Expanded(
              flex: 2,
              child: _NumField(label: '목표 농도', controller: concCtrl, onChanged: (_) => setState(() {})),
            ),
            const SizedBox(width: 8),
            _UnitDropdown<ConcUnit>(
              value: concUnit,
              items: ConcUnit.values,
              labelOf: (u) => u.label,
              onChanged: (u) => setState(() => concUnit = u),
            ),
          ],
        ),
        const SizedBox(height: 12),
        Row(
          children: [
            Expanded(
              flex: 2,
              child: _NumField(label: '최종 부피', controller: volCtrl, onChanged: (_) => setState(() {})),
            ),
            const SizedBox(width: 8),
            _UnitDropdown<VolUnit>(
              value: volUnit,
              items: VolUnit.values,
              labelOf: (u) => u.label,
              onChanged: (u) => setState(() => volUnit = u),
            ),
          ],
        ),
        const SizedBox(height: 12),
        _NumField(label: '분자량 (g/mol)', controller: mwCtrl, onChanged: (_) => setState(() {})),
        const SizedBox(height: 12),
        Align(
          alignment: Alignment.centerRight,
          child: _UnitDropdown<MassUnit>(
            value: massUnit,
            items: MassUnit.values,
            labelOf: (u) => '결과 단위: ${u.label}',
            onChanged: (u) => setState(() => massUnit = u),
          ),
        ),
        if (result != null)
          _resultCard('필요한 질량', '${_fmtNum(result!)} ${massUnit.label}'),
      ],
    );
  }
}

/// 2) 희석 계산 C1V1 = C2V2  -> V1 = C2*V2 / C1
class _DilutionForm extends StatefulWidget {
  const _DilutionForm();

  @override
  State<_DilutionForm> createState() => _DilutionFormState();
}

class _DilutionFormState extends State<_DilutionForm> {
  final c1Ctrl = TextEditingController();
  final c2Ctrl = TextEditingController();
  final v2Ctrl = TextEditingController();
  VolUnit v2Unit = VolUnit.mL;

  // C1, C2는 같은 단위(배수 등)이기만 하면 되므로 단위 변환 없이 그대로 비율 계산
  double? get v1 {
    final c1 = double.tryParse(c1Ctrl.text);
    final c2 = double.tryParse(c2Ctrl.text);
    final v2 = double.tryParse(v2Ctrl.text);
    if (c1 == null || c2 == null || v2 == null || c1 == 0) return null;
    return c2 * v2 / c1;
  }

  double? get diluent {
    final v2 = double.tryParse(v2Ctrl.text);
    final vv1 = v1;
    if (v2 == null || vv1 == null) return null;
    return v2 - vv1;
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'C1 × V1 = C2 × V2  (C1, C2는 같은 농도 단위로 입력: 예) 둘 다 M, 둘 다 배수(x)',
          style: TextStyle(color: Colors.grey, fontSize: 13),
        ),
        const SizedBox(height: 12),
        _NumField(label: '원액 농도 (C1)', controller: c1Ctrl, onChanged: (_) => setState(() {})),
        const SizedBox(height: 12),
        _NumField(label: '목표 농도 (C2)', controller: c2Ctrl, onChanged: (_) => setState(() {})),
        const SizedBox(height: 12),
        Row(
          children: [
            Expanded(
              flex: 2,
              child: _NumField(label: '최종 부피 (V2)', controller: v2Ctrl, onChanged: (_) => setState(() {})),
            ),
            const SizedBox(width: 8),
            _UnitDropdown<VolUnit>(
              value: v2Unit,
              items: VolUnit.values,
              labelOf: (u) => u.label,
              onChanged: (u) => setState(() => v2Unit = u),
            ),
          ],
        ),
        if (v1 != null && diluent != null) ...[
          _resultCard('원액 (C1) 필요량', '${_fmtNum(v1!)} ${v2Unit.label}'),
          _resultCard('추가할 용매(희석액)', '${_fmtNum(diluent!)} ${v2Unit.label}', color: Colors.lightBlueAccent),
        ],
      ],
    );
  }
}

/// 3) %농도(w/v) -> 질량 : %w/v = g / 100mL  ->  mass_g = percent * volume_mL / 100
class _PercentToMassForm extends StatefulWidget {
  const _PercentToMassForm();

  @override
  State<_PercentToMassForm> createState() => _PercentToMassFormState();
}

class _PercentToMassFormState extends State<_PercentToMassForm> {
  final percentCtrl = TextEditingController();
  final volCtrl = TextEditingController();
  VolUnit volUnit = VolUnit.mL;
  MassUnit massUnit = MassUnit.g;

  double? get result {
    final p = double.tryParse(percentCtrl.text);
    final v = double.tryParse(volCtrl.text);
    if (p == null || v == null) return null;
    final volumeMl = v * volUnit.toL * 1000;
    final massG = p * volumeMl / 100;
    return massG * massUnit.fromG;
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          '%w/v 기준: 목표 % × 최종 부피 = 필요한 질량 (g/100mL 기준)',
          style: TextStyle(color: Colors.grey, fontSize: 13),
        ),
        const SizedBox(height: 12),
        _NumField(label: '목표 농도 (% w/v)', controller: percentCtrl, onChanged: (_) => setState(() {})),
        const SizedBox(height: 12),
        Row(
          children: [
            Expanded(
              flex: 2,
              child: _NumField(label: '최종 부피', controller: volCtrl, onChanged: (_) => setState(() {})),
            ),
            const SizedBox(width: 8),
            _UnitDropdown<VolUnit>(
              value: volUnit,
              items: VolUnit.values,
              labelOf: (u) => u.label,
              onChanged: (u) => setState(() => volUnit = u),
            ),
          ],
        ),
        const SizedBox(height: 12),
        Align(
          alignment: Alignment.centerRight,
          child: _UnitDropdown<MassUnit>(
            value: massUnit,
            items: MassUnit.values,
            labelOf: (u) => '결과 단위: ${u.label}',
            onChanged: (u) => setState(() => massUnit = u),
